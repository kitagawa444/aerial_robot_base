repositories:
  ros2_numpy:
    type: git
    url: "https://github.com/Box-Robotics/ros2_numpy.git"
    version: "humble"
    local-name: "ros2_numpy"

  kalman_filter:
    type: git
    url: "https://github.com/ut-dragon-lab/kalman_filter.git"
    version: "ros2"
    local-name: "kalman_filter"
    
  aerial_robot_nerve:
    type: git
    url: "https://github.com/ut-dragon-lab/aerial_robot_nerve.git"
    version: "master"
    local-name: "aerial_robot_nerve"

  livox_ros_driver2:
    type: git
    url: "https://github.com/kitagawa444/livox_ros_driver2.git"
    version: "ROS2"
    local-name: "livox_ros_driver2"

  FAST_LIO:
    type: git
    url: "https://github.com/kitagawa444/fast_lio.git"
    version: "ROS2"
    local-name: "FAST_LIO"
